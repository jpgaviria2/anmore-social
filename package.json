{
  "name": "anmore-social",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=esm --outfile=app.js",
    "test": "node --test tests/*.test.js",
    "qa": "node tests/browser-qa.js && node tests/top-buttons-qa.js",
    "qa:pwa": "node tests/pwa-browser-qa.js && node tests/sw-browser-qa.js",
