    "icons:pwa": "node tests/generate-pwa-icons.js"
  },
  "dependencies": {
    "@noble/curves": "1.2.0",
    "@noble/hashes": "1.3.1",
    "@scure/base": "1.1.1",
    "nostr-tools": "2.17.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "esbuild": "0.25.12",
    "jsqr": "1.4.0",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "prettier": "3.6.2"
  }
}
